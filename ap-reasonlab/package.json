{
  "name": "ap-reasonlab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:webllm && npm run validate:questions && next build",
    "start": "next start",
    "lint": "next lint",
    "check:webllm": "node scripts/check-webllm-version.mjs",
    "check:ai-latex": "tsx scripts/check-ai-latex.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:english": "tsx scripts/validate-english-questions.ts",
    "validate:questions": "tsx scripts/validate-question-bank.ts",
    "generate:english-batch3": "tsx scripts/generate-english-batch3.ts",
    "generate:curated-extended": "tsx scripts/generate-curated-extended.ts",
    "generate:hard-english": "tsx scripts/generate-hard-english.ts",
    "generate:ap-units": "tsx scripts/generate-ap-units-from-formulas.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.82",
    "katex": "^0.18.1",
    "mammoth": "^1.12.0",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "@playwright/test": "^1.51.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
